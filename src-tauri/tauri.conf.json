{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IRCord",
  "version": "0.1.0",
  "identifier": "com.ircord.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:frontend",
    "devUrl": "http://127.0.0.1:4789",
    "beforeBuildCommand": "bun run build:frontend",
    "frontendDist": "../setup"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/ircord-bun"],
    "resources": { "frontend-dist/": "frontend/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
