{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IRCord",
  "version": "0.1.0",
  "identifier": "com.ircord.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:frontend",
    "devUrl": "http://127.0.0.1:4789",
    "beforeBuildCommand": "bun run build:frontend",
    "frontendDist": "frontend-dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.klipy.com https://static.klipy.com https://media.klipy.com https://cdn.klipy.com https://huggingface.co https://*.hf.co",
        "img-src": "'self' data: blob: https: http://127.0.0.1:*",
        "media-src": "'self' blob: https: http://127.0.0.1:*",
        "frame-src": "'self' https:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:4789 https:; img-src 'self' data: blob: https: http://127.0.0.1:*; media-src 'self' blob: https: http://127.0.0.1:*; frame-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "depends": ["ca-certificates"] } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzMTVGRTVDMTA3NkQ4MTUKUldRVjJIWVFYUDRWSTRCakJOdWwxdGh0Z2tnQUNhbm5OTDZtNXVWdmVnS3k1anpTY2hSTFFSaWoK",
      "endpoints": ["https://github.com/ircord/desktop/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
