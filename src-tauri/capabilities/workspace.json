{
  "identifier": "workspace",
  "description": "Native transport, window and notification access for the IRCord frontend.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-choose-server",
    "allow-check-for-updates",
    "allow-api-request",
    "allow-cancel-request",
    "allow-speech-request",
    "allow-open-socket",
    "allow-send-socket",
    "allow-close-socket",
    "allow-notification-permission",
    "allow-request-notification-permission",
    "allow-show-notification",
    "allow-focus-notification-window",
    "notification:allow-is-permission-granted",
    "clipboard-manager:allow-write-text",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-resize-dragging"
  ]
}
