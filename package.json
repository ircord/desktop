{
  "name": "ircord-desktop",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "tauri dev --config src-tauri/tauri.web.conf.json",
    "build": "tauri build",
    "dev:frontend": "bun run icons && bun --no-env-file scripts/build-frontend.ts --dev",
    "build:frontend": "bun run icons && bun --no-env-file scripts/build-frontend.ts",
    "icons": "tauri icon ../frontend/public/icons/icon-512.png"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6"
  }
}
